        {
          "name": "对象检测与去干扰",
          "role": "检测",
          "do": "正弦候选搜索、连通域、形态筛选与碎片合并",
          "effect": "输出轨迹和孔洞区域；纵向干扰不计入天然裂缝条数。",
          "trap": "形态规则也可能漏掉真实断续裂缝。"
        },
        {
          "name": "专业参数计算",
          "role": "解释",
          "do": "从拟合轨迹、对象面积与标定值计算",
          "effect": "裂缝条数/P10、倾角/倾向/走向、开度估计、孔洞面积与等效直径。",
          "trap": "开度依赖本例已知成像模型，不是未经标定的现场真值。"
        },
        {
          "name": "分层验证与复核",
          "role": "验证",
          "do": "像素IoU、对象匹配、几何误差、参考叠加",
          "effect": "展示误检和漏检；所有结果可导出并回查。",
          "trap": "测试参考只用于评估，不应反复调参后宣称泛化。"
        }
      ],
